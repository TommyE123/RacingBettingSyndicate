{
  "name": "Racing Betting Syndicate",
  "runArgs": ["--name", "racingbettingsyndicate-devcontainer"],
  "privileged": true,
  "build": {
    "dockerfile": "Dockerfile"
  },

  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "mounts": [
    "source=racingbettingsyndicate-dind-${devcontainerId},target=/var/lib/docker,type=volume",
    "source=racingbettingsyndicate-cache,target=/home/vscode/.cache,type=volume",
    "source=racingbettingsyndicate-gh-cache,target=/home/vscode/.local/share/gh,type=volume",
    "source=racingbettingsyndicate-mise-data,target=/home/vscode/.local/share/mise,type=volume"
  ],

  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "waitFor": "postCreateCommand",

  "forwardPorts": [3420, 8420],

  "portsAttributes": {
    "3420": {
      "label": "Frontend (Next.js)"
    },
    "8420": {
      "label": "Backend API (FastAPI)"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "editorconfig.editorconfig",
        "esbenp.prettier-vscode",
        "foxundermoon.shell-format",
        "github.vscode-github-actions",
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "redhat.vscode-xml",
        "redhat.vscode-yaml",
        "timonwong.shellcheck",
        "DavidAnson.vscode-markdownlint",
        "stylelint.vscode-stylelint",
        "vitest.explorer",
        "yzhang.markdown-all-in-one"
      ]
    }
  },

  "containerEnv": {
    "NPM_CONFIG_CACHE": "/home/vscode/.cache/npm",
    "npm_config_store_dir": "/home/vscode/.cache/pnpm",
    "UV_LINK_MODE": "copy"
  },

  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.devcontainer/node_modules/.bin:/home/vscode/.local/share/mise/shims:/home/vscode/.local/bin:${containerEnv:PATH}",
    "MISE_GLOBAL_CONFIG_FILE": "${containerWorkspaceFolder}/mise.toml"
  },

  "remoteUser": "vscode",
  "shutdownAction": "stopContainer"
}
